      <aliases enabled='yes' />
      <column caption='Pre-Post COVID dummy' datatype='string' name='[Calculation_1327717516412022784]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Month] &lt; #2020-03-01# THEN &quot;Pre-COVID&quot;&#13;&#10;ELSE &quot;Post-COVID&quot;&#13;&#10;END' />
      </column>
      <column caption='Time Index' datatype='integer' name='[Calculation_1327717516413190146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, #2016-01-01#, [Month])' />
      </column>
      <column caption='Post Dummy' datatype='integer' name='[Calculation_1327717516413288451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Month] &gt;= #2020-03-01# THEN 1 ELSE 0 END' />
      </column>
      <column caption='Interaction Term' datatype='integer' name='[Calculation_1327717516413427716]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1327717516413190146] * [Calculation_1327717516413288451]' />
      </column>
      <column caption='UPI % Change' datatype='real' name='[Calculation_1626362467604733952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Calculation_1327717516413288451] = 1 THEN [Growth_rate_upi] END) -&#13;&#10;AVG(IF [Calculation_1327717516413288451] = 0 THEN [Growth_rate_upi] END)' />
      </column>
      <column caption='Digital % Change ' datatype='real' name='[Calculation_1626362467605118977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Calculation_1327717516413288451] = 1 THEN [Growth_rate_digital] END) -&#13;&#10;AVG(IF [Calculation_1327717516413288451] = 0 THEN [Growth_rate_digital] END)' />
      </column>
      <column caption='% Change in Currency' datatype='real' name='[Calculation_1626362467605270530]' role='measure' type='quantitative'>
